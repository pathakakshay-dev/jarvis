# Copy to .env and fill in only the provider you use.
# Keys stay in this file. They are never written into source or logs.
# JARVIS_PROVIDER=fake works with no key and no network.

JARVIS_PROVIDER=fake

JARVIS_GROQ_API_KEY=
# Set this to a model id your Groq account currently offers.
JARVIS_GROQ_MODEL=openai/gpt-oss-20b

JARVIS_GEMINI_API_KEY=
# Set this to a model id currently enabled in Google AI Studio.
JARVIS_GEMINI_MODEL=gemini-2.5-flash

JARVIS_CHAT_TIMEOUT_S=45
JARVIS_MAX_STEPS=4
JARVIS_PORT=8765

# Whisper small runs for one recording, then unloads. auto, cpu, or cuda.
# This PC's driver is CUDA 11.7, so auto stays on the CPU.
JARVIS_WHISPER_DEVICE=auto
# Whisper small on this CPU can take longer than one minute for one clip.
JARVIS_VOICE_TIMEOUT_S=180
